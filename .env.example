# Environment Variables Example for ExpenseFlow

SECRET_KEY=your-production-secret-key-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,expense-tracker-web.onrender.com
DATABASE_URL=postgresql://user:password@hostname:5432/database_name
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.render.com

# MongoDB Database Connection (for Chat Logs and Feedback)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/expensetracker?retryWrites=true&w=majority
MONGODB_DB_NAME=expensetracker

# Optional AI Engine Key (Gemini API for enhanced conversational abilities)
GEMINI_API_KEY=your_gemini_api_key_here
